# Copy to .env and fill in to test REAL data collection locally.
# (In the cloud, keys live in GitHub repo Secrets and the nightly Action
#  collects into data/buzztrend.db — the app auto-switches to real mode
#  when that file exists. USE_MOCK env var overrides auto-detection.)

USE_MOCK=true

# How often the scheduler collects (minutes)
COLLECT_INTERVAL_MINUTES=60
# How many days of history to generate when seeding mock data
SEED_DAYS=90
# Spike alert fires when today's count > this ratio * trailing 7-day average
ALERT_SPIKE_RATIO=1.5

# --- Korea: Naver Search API (https://developers.naver.com) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Global: YouTube Data API v3 (https://console.cloud.google.com) ---
YOUTUBE_API_KEY=

# --- Global: Reddit (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=buzztrend/0.1
